# Copy this file to .env and adjust. Never commit .env.

# Frontend addresses allowed to call the API (comma-separated).
FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Database. SQLite stores everything in a local file in the project folder.
DATABASE_URL=sqlite:///./moodmentor.db

# Secret used to sign login tokens. Generate your own value; never share it.
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60


# Emotion detection (set EMOTION_ENABLED=false to switch it off).
EMOTION_ENABLED=true
EMOTION_MODEL_NAME=SamLowe/roberta-base-go_emotions